{
  "buildCommand": "npm run build:cloud",
  "outputDirectory": "dist",
  "cloudFunctions": {
    "nodejs": {
      "includeFiles": []
    }
  },
  "agents": {
    "timeout": 300,
    "framework": "openai-agents-sdk",
    "sandbox": {
      "timeout": 300
    }
  },
  "kvNamespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
