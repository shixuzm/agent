# LLM Gateway Configuration
# Required: OpenAI-compatible LLM API credentials
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional: model name (defaults to @makers/deepseek-v4-flash)
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# Optional: Makers KV binding name for persistent storage
# If not set, the app falls back to in-memory store (data lost on restart)
# EDGEONE_KV_BINDING=KV

# Optional: application runtime mode
# - cloud: deploy to EdgeOne Makers, shows login + demo + download page
# - local (default): full agent chat and management features
# VITE_APP_MODE=local

# Optional: 前端直连 LLM 模式（移动端 / Capacitor WebView）
# 设为 true 时，前端跳过后端 EdgeOne Makers，直接在浏览器内调用 shared/llm.ts
# 的 chatCompletion 与 shared/store.ts 的 MemoryStore。
# 同时也会在检测到 window.capacitor.isNative=true 时自动启用。
# 注意：直连模式下不运行 orchestrator（依赖 Node.js fs），因此跳过任务规划、
# 智能体选择、自我反思等后端能力，仅用当前选中的智能体 systemPrompt 直接对话。
# VITE_DIRECT_LLM=false

# DSpark framework configuration
# Endpoint of the DSpark service (required to enable skill_dspark)
# DSPARK_ENDPOINT=https://dspark.example.com/v1
# API key for DSpark service authentication (optional)
# DSPARK_API_KEY=your-dspark-api-key
# Default cluster to use when not specified in request (optional)
# DSPARK_DEFAULT_CLUSTER=default
