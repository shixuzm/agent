# Build-time configuration only (Vite build variables)
# All runtime API configuration is done in-app via Settings panel

# Application mode: 'local' (default) or 'cloud'
VITE_APP_MODE=local

# When set to 'true', frontend calls LLM service directly (for mobile/desktop apps)
# VITE_DIRECT_LLM=true

# DSpark framework configuration (build-time hints only, runtime config in Settings)
# DSPARK_ENDPOINT, DSPARK_API_KEY, DSPARK_DEFAULT_CLUSTER are configured in-app
